{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "id", "slug", "order", "title", "description", "theme", "levelCount", "levelsPerPack", "offlineStarter", "packIds", "legacyLevelIds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^w[0-9]{2}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "order": {"type": "integer", "minimum": 1, "maximum": 20},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "theme": {"type": "string"},
    "levelCount": {"const": 50},
    "levelsPerPack": {"const": 25},
    "offlineStarter": {"type": "boolean"},
    "packIds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "legacyLevelIds": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
